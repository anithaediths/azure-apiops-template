# Azure Configuration
AZURE_SUBSCRIPTION_ID="your-subscription-id-here"
AZURE_RESOURCE_GROUP="rg-apim-dev"
AZURE_REGION="eastus"
AZURE_TENANT_ID="your-tenant-id-here"

# APIM Configuration
APIM_NAME="apim-dev"
APIM_PUBLISHER_NAME="Your Organization Name"
APIM_PUBLISHER_EMAIL="admin@yourdomain.com"
APIM_SKU="Standard"
APIM_CAPACITY="1"

# Environment
ENVIRONMENT="dev"

# Backend Service
BACKEND_SERVICE_URL="https://your-backend.azurewebsites.net"

# Logging
LOG_RETENTION_DAYS="30"

# GitHub (for CI/CD)
GITHUB_TOKEN="your-github-token-here"
GITHUB_REPOSITORY="anithaediths/azure-apiops-template"
